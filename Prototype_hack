      "source": [
        "# Calculate individual risk scores\n",
        "\n",
        "data[\"rain_score\"] = data[\"rainfall_mm\"] / data[\"rainfall_mm\"].max()\n",
        "\n",
        "data[\"water_score\"] = data[\"water_level_m\"] / data[\"water_level_m\"].max()\n",
        "\n",
        "data[\"elevation_score\"] = 1 - (\n",
        "    data[\"elevation_m\"] / data[\"elevation_m\"].max()\n",
        ")\n",
        "\n",
        "# Overall flood-risk score\n",
        "data[\"risk_score\"] = (\n",
        "    0.40 * data[\"rain_score\"] +\n",
        "    0.35 * data[\"water_score\"] +\n",
        "    0.25 * data[\"elevation_score\"]\n",
        ") * 100\n",
        "\n",
        "data"
      ],
