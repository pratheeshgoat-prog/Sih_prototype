        "def get_building_risk(lat, lon):\n",
        "\n",
        "    distances = (\n",
        "        (data[\"latitude\"] - lat)**2 +\n",
        "        (data[\"longitude\"] - lon)**2\n",
        "    )\n",
        "\n",
        "    nearest_index = distances.idxmin()\n",
        "\n",
        "    return data.loc[nearest_index, \"risk\"]\n",
        "\n",
        "\n",
        "buildings[\"risk\"] = buildings.apply(\n",
        "    lambda row: get_building_risk(\n",
        "        row[\"latitude\"],\n",
        "        row[\"longitude\"]\n",
        "    ),\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "buildings"
      ],
