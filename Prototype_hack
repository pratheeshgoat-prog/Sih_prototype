        "        return \"CRITICAL\"\n",
        "\n",
        "    if row[\"risk\"] == \"HIGH\":\n",
        "        return \"HIGH\"\n",
        "\n",
        "    if row[\"risk\"] == \"MEDIUM\":\n",
        "        return \"MEDIUM\"\n",
        "\n",
        "    return \"LOW\"\n",
        "\n",
        "\n",
        "buildings[\"priority\"] = buildings.apply(priority, axis=1)\n",
        "\n",
        "buildings"
