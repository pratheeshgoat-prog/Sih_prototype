        "import folium\n",
        "\n",
        "# Create the map\n",
        "m = folium.Map(\n",
        "    location=[11.025, 76.96],\n",
        "    zoom_start=13\n",
        ")\n",
        "\n",
        "# Add each flood-risk location\n",
        "for _, row in data.iterrows():\n",
        "\n",
        "    if row[\"risk\"] == \"HIGH\":\n",
        "        colour = \"red\"\n",
        "    elif row[\"risk\"] == \"MEDIUM\":\n",
        "        colour = \"orange\"\n",
        "    else:\n",
        "        colour = \"green\"\n",
        "\n",
        "    folium.CircleMarker(\n",
        "        location=[row[\"latitude\"], row[\"longitude\"]],\n",
        "        radius=12,\n",
        "        popup=(\n",
        "            f\"Location: {row['location']}<br>\"\n",
        "            f\"Rainfall: {row['rainfall_mm']} mm<br>\"\n",
        "            f\"Water Level: {row['water_level_m']} m<br>\"\n",
        "            f\"Risk Score: {row['risk_score']:.1f}<br>\"\n",
        "            f\"Risk: {row['risk']}\"\n",
        "        ),\n",
        "        color=colour,\n",
        "        fill=True,\n",
        "        fill_color=colour,\n",
        "        fill_opacity=0.7\n",
        "    ).add_to(m)\n",
        "\n",
        "m"
